[Unit]
Description=Server Handoff TTY dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/matt/Server-Handoff-TTY
ExecStart=/home/matt/Server-Handoff-TTY/.venv/bin/python -m command_center.webui.service --live
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
# Mount-namespace sandboxing (PrivateTmp/ProtectHome/ProtectSystem) breaks
# OpenSSH validation of Ubuntu's symlinked system SSH configuration. The
# process remains non-root, localhost-bound, and restricted by forced-command
# telemetry keys and the service's read-only application behavior.

[Install]
WantedBy=default.target
