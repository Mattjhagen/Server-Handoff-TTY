#!/usr/bin/env python3
"""Fixed, read-only telemetry command intended for forced-command SSH keys."""
import os
import pathlib
import subprocess
import time

def meminfo():
    values = {}
    for line in pathlib.Path('/proc/meminfo').read_text().splitlines():
        key, value = line.split(':', 1)
        values[key] = float(value.strip().split()[0]) / 1024
    return values

mem = meminfo()
load = os.getloadavg()[0]
cpu_count = max(1, os.cpu_count() or 1)
print(f"cpu_percent={min(100.0, load / cpu_count * 100):.1f}")
print(f"ram_used_mb={mem.get('MemTotal', 0)-mem.get('MemAvailable', 0):.1f}")
print(f"ram_total_mb={mem.get('MemTotal', 0):.1f}")
print(f"load_1={load:.2f}")
print(f"uptime_s={float(pathlib.Path('/proc/uptime').read_text().split()[0]):.0f}")
print(f"process_count={len([p for p in pathlib.Path('/proc').iterdir() if p.name.isdigit()])}")
print('[processes]')
proc = subprocess.run(['ps','-eo','pid=,comm=','--sort=-%cpu'], capture_output=True, text=True, timeout=3)
for line in proc.stdout.splitlines()[:12]:
    parts = line.strip().split(maxsplit=1)
    if len(parts) == 2:
        print(f"{parts[0]}|{parts[1]}")

# The dashboard key may read only these two durable, non-secret agent-state
# files.  The identity is fixed by hostname; no caller-controlled path is
# accepted.  Output is bounded and sanitized again by the collector.
agent_by_host = {
    't310': 'pm-t310',
    'r510': 'dev-r510',
    'r410': 'security-r410',
}
agent_id = agent_by_host.get(os.uname().nodename.split('.')[0].lower(), '')
if not agent_id and state_root.exists():
    active_reports = [p for p in state_root.glob("*/latest.md") if p.is_file()]
    if active_reports:
        active_reports.sort(key=lambda p: p.stat().st_mtime, reverse=True)
        report = active_reports[0]
        agent_id = report.parent.name
state_root = pathlib.Path('/home/matt/Projects/.agent-state')
if agent_id:
    report = state_root / agent_id / 'latest.md'
    todos = state_root / agent_id / 'todos.json'
    print('[agent_report]')
    try:
        print(report.read_text(errors='replace')[:8192])
    except OSError:
        pass
    print('[todos_json]')
    try:
        # JSON is emitted verbatim inside a bounded section and parsed without
        # shell evaluation by the dashboard.
        print(todos.read_text(errors='replace')[:16384])
    except OSError:
        pass
